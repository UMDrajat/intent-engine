# =============================================================================
# Intent Engine - Docker Compose Environment Configuration
# =============================================================================
# This file contains environment variables for the Docker Compose setup.
# Copy this to .env and customize for your environment.
#
# DO NOT COMMIT .env FILES TO VERSION CONTROL!
# =============================================================================

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
WORKERS=2
API_PORT_EXTERNAL=8000

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
POSTGRES_USER=intent_user
POSTGRES_PASSWORD=intent_secure_password_change_in_prod
POSTGRES_DB=intent_engine
POSTGRES_PORT_EXTERNAL=5432

# Database Connection Pool
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# PgBouncer (optional - enable with --profile pgbouncer)
PGBOUNCER_ENABLED=false
PGBOUNCER_PORT_EXTERNAL=6543

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_MAX_CONNECTIONS=50
REDIS_TIMEOUT=5.0

# =============================================================================
# Security Configuration
# =============================================================================
# IMPORTANT: Generate a secure random key for production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# CORS Configuration
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_STRICT=10/minute

# =============================================================================
# SearXNG Configuration
# =============================================================================
SEARXNG_PORT_EXTERNAL=8080
SEARXNG_BASE_URL=http://localhost:8080
# Generate with: openssl rand -hex 32
SEARXNG_SECRET_KEY=
SEARXNG_LIMITER=false
SEARXNG_IMAGE_PROXY=true

# =============================================================================
# Qdrant Vector Database
# =============================================================================
QDRANT_PORT_EXTERNAL=6333
QDRANT_GRPC_PORT_EXTERNAL=6334

# =============================================================================
# Go Services Configuration (optional - enable with --profile go-services)
# =============================================================================
ENABLE_GO_SERVICES=false

# Go Search API
GO_SEARCH_API_PORT_EXTERNAL=8081
GO_SEARCH_API_URL=http://go-search-api:8080

# Go Unified Search API
GO_UNIFIED_SEARCH_API_PORT_EXTERNAL=8082
GO_UNIFIED_SEARCH_API_URL=http://unified-search-api:8082

# Go Crawler
GO_CRAWLER_SEED_URLS=https://go.dev,https://golang.org
GO_CRAWLER_MAX_PAGES=100
GO_CRAWLER_MAX_DEPTH=2
GO_CRAWLER_CONCURRENCY=3
GO_CRAWLER_DELAY=2000

# Go Indexer
GO_INDEXER_BATCH_SIZE=50
GO_INDEXER_INTERVAL=60

# Go Services Database (defaults to POSTGRES_* if not set)
# GO_SEARCH_DB_USER=intent_user
# GO_SEARCH_DB_PASSWORD=intent_secure_password_change_in_prod
# GO_SEARCH_DB_HOST=postgres
# GO_SEARCH_DB_PORT=5432
# GO_SEARCH_DB_NAME=intent_engine

# Unified Search Configuration
SEARXNG_URL=http://searxng:8080
QDRANT_ADDR=qdrant:6333
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
PARALLEL_SEARCH=true

# =============================================================================
# ML Model Configuration
# =============================================================================
MODEL_CACHE_DIR=/app/data/models
TRANSFORMERS_CACHE=/app/data/transformers
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2
SENTENCE_TRANSFORMERS_DEVICE=cpu

# =============================================================================
# Privacy & Compliance
# =============================================================================
ENABLE_ANONYMIZATION=true
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
ANONYMIZATION_SALT=generate-random-salt-for-anonymization
CONSENT_REQUIRED=true
SESSION_DATA_RETENTION_HOURS=8

# =============================================================================
# Monitoring & Observability (optional - enable with --profile monitoring)
# =============================================================================
ENABLE_METRICS=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Prometheus
PROMETHEUS_PORT_EXTERNAL=9090

# Grafana
GRAFANA_PORT_EXTERNAL=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_secure_password_change_in_prod
GRAFANA_ROOT_URL=http://localhost:3000

# =============================================================================
# Background Tasks (ARQ Worker - optional - enable with --profile worker)
# =============================================================================
ARQ_WORKER_CONCURRENCY=5
ARQ_WORKER_MAX_JOBS=100

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_NEW_RANKING_ALGORITHM=false
FEATURE_ADVANCED_FRAUD_DETECTION=true
FEATURE_A_B_TESTING=true
FEATURE_REAL_TIME_ANALYTICS=true

# =============================================================================
# Development Overrides
# =============================================================================
# Enable debug mode (do not use in production)
DEBUG=false

# Enable hot reload (development only)
RELOAD=false

# Disable SSL verification (development only)
SSL_VERIFY=false

# =============================================================================
# Production Example Values (Reference - Uncomment and customize for production)
# =============================================================================
# ENVIRONMENT=production
# LOG_LEVEL=WARNING
# WORKERS=4
# SECRET_KEY=<generate-with-python-secrets-token-urlsafe-32>
# POSTGRES_PASSWORD=<secure-database-password>
# GRAFANA_ADMIN_PASSWORD=<secure-grafana-password>
# SEARXNG_SECRET_KEY=<generate-with-openssl-rand-hex-32>
# ANONYMIZATION_SALT=<random-salt-string>
# CORS_ORIGINS=https://yourdomain.com
# ENABLE_GO_SERVICES=true
# ENABLE_QDRANT=true
